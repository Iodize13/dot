// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "shift shift": "file_finder::Toggle"
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "context": "FileFinder || FileFinder > Picker > Editor",
    "unbind": {
      "ctrl-p": "file_finder::Toggle",
    },
  },
  {
    "context": "Editor && VimControl",
    "bindings": {
      "space f": "file_finder::Toggle",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-x": "command_palette::Toggle",
    },
  },
  {
    "context": "VimControl || (ProjectPanel && not_editing)",
    "bindings": {
      "space i": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "vim_mode == normal || vim_mode == visual",
    "bindings": {
      "s": "vim::PushSneak",
      "shift-s": "vim::PushSneakBackward",
    },
  },
  {
    "context": "VimControl && !menu && vim_mode != operator",
    "bindings": {
      "w": "vim::NextSubwordStart",
      "b": "vim::PreviousSubwordStart",
      "e": "vim::NextSubwordEnd",
      "g e": "vim::PreviousSubwordEnd",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-alt-shift-t": [
        "task::Spawn",
        { "task_name": "Qualiva: Start Tunnel" },
      ],
      "ctrl-alt-shift-g": [
        "task::Spawn",
        { "task_name": "Qualiva: Start Go Dev" },
      ],
      "ctrl-alt-shift-d": [
        "task::Spawn",
        { "task_name": "Qualiva: Start Vite Server" },
      ],
      "ctrl-alt-shift-q": ["workspace::SendKeystrokes", "ctrl-alt-shift-g"],
    },
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-p": "file_finder::Toggle",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-p": "file_finder::Toggle",
    },
  },
  // {
  //   "context": "AgentPanel > Terminal",
  //   "bindings": {
  //     "ctrl-b c": "agent::NewThread",
  //   },
  // },
  {
    "context": "AgentPanel > Terminal",
    "unbind": {
      "ctrl-n": "agent::NewThread",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-n": "workspace::NewFile",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-s": "workspace::Save",
    },
  },
]
