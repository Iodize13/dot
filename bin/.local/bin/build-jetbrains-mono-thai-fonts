#!/usr/bin/env bash
# Builds two Thai-merged JetBrains Mono family pairs:
#
#  - "JetBrains Mono Thai" / "JetBrainsMono NF Thai": Thai glyphs from Noto
#    Sans Thai Looped. Used by Zed for its looped Thai look.
#  - "JetBrains Mono Thai PW" / "JetBrainsMono NF Thai PW": Thai glyphs from
#    PW Thai Monospaced EG (remapped to the Thai Unicode block, see
#    ~/fonts/pw-thai-monospaced). Used by Emacs for true fixed-width Thai
#    alignment in vterm/TUIs.
#
# Both merge into JetBrains Mono / JetBrainsMono Nerd Font, normalizing Thai
# advance widths to the monospace cell so the terminal/editor grid stays
# aligned.
#
# Requires: fonttools (pyftmerge, pip install fonttools), python3
# Source font packages (Arch): ttf-jetbrains-mono, ttf-jetbrains-mono-nerd, noto-fonts
#
# Output installed to $XDG_DATA_HOME/fonts/jetbrains-mono-thai (or
# ~/.local/share/fonts if XDG_DATA_HOME is unset), then fc-cache is refreshed.

set -euo pipefail

JBM_DIR=/usr/share/fonts/TTF
OUT_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/fonts/jetbrains-mono-thai"
CELL_WIDTH=600 # JetBrains Mono's monospace advance width

NOTO_THAI=/usr/share/fonts/noto/NotoSansThaiLooped-Regular.ttf
PW_THAI="$HOME/fonts/pw-thai-monospaced/PWThaiMonospacedEG-thai.ttf"

WORKDIR=$(mktemp -d)
trap 'rm -rf "$WORKDIR"' EXIT

fix_metrics() {
  local src=$1 dst=$2 family=$3
  python3 - "$src" "$dst" "$family" <<'PYEOF'
import sys
from fontTools.ttLib import TTFont

src, dst, family_name = sys.argv[1], sys.argv[2], sys.argv[3]
CELL_WIDTH = 600

f = TTFont(src)
cmap = f.getBestCmap()
hmtx = f["hmtx"]

for cp in range(0x0E00, 0x0E80):
    glyph = cmap.get(cp)
    if glyph is None:
        continue
    advance, lsb = hmtx[glyph]
    if advance == 0:
        continue  # zero-width combining marks (tone marks, vowel signs)
    new_lsb = lsb + (CELL_WIDTH - advance) // 2
    hmtx[glyph] = (CELL_WIDTH, new_lsb)

subfamily = "Regular"
for rec in f["name"].names:
    if rec.nameID == 2 and rec.platformID == 3:
        subfamily = rec.toUnicode()

for rec in f["name"].names:
    if rec.nameID == 1:
        rec.string = family_name
    elif rec.nameID == 4:
        rec.string = f"{family_name} {subfamily}"
    elif rec.nameID == 6:
        rec.string = f"{family_name.replace(' ', '')}-{subfamily.replace(' ', '')}"
    elif rec.nameID == 16:
        rec.string = family_name
    elif rec.nameID == 17:
        rec.string = subfamily

f.save(dst)
PYEOF
}

build_variant() {
  local base_font=$1 thai_font=$2 out_name=$3 family=$4
  pyftmerge "$base_font" "$thai_font" --output-file="$WORKDIR/merged.ttf" >/dev/null
  fix_metrics "$WORKDIR/merged.ttf" "$OUT_DIR/$out_name" "$family"
  rm -f "$WORKDIR/merged.ttf"
}

mkdir -p "$OUT_DIR"

for w in Regular Bold Italic BoldItalic; do
  echo "Building JetBrains Mono Thai $w (Noto, for Zed)..."
  build_variant "$JBM_DIR/JetBrainsMono-$w.ttf" "$NOTO_THAI" "JetBrainsMonoThai-$w.ttf" "JetBrains Mono Thai"

  echo "Building JetBrainsMono NF Thai $w (Noto, for Zed)..."
  build_variant "$JBM_DIR/JetBrainsMonoNerdFont-$w.ttf" "$NOTO_THAI" "JetBrainsMonoNFThai-$w.ttf" "JetBrainsMono NF Thai"

  echo "Building JetBrains Mono Thai PW $w (for Emacs)..."
  build_variant "$JBM_DIR/JetBrainsMono-$w.ttf" "$PW_THAI" "JetBrainsMonoThaiPW-$w.ttf" "JetBrains Mono Thai PW"

  echo "Building JetBrainsMono NF Thai PW $w (for Emacs)..."
  build_variant "$JBM_DIR/JetBrainsMonoNerdFont-$w.ttf" "$PW_THAI" "JetBrainsMonoNFThaiPW-$w.ttf" "JetBrainsMono NF Thai PW"
done

fc-cache -f "$OUT_DIR" >/dev/null
echo "Done. Installed to $OUT_DIR"
