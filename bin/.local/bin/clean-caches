#!/bin/sh
# Prune rebuildable caches in $HOME. Run monthly by clean-caches.timer.
# Leaves ~/.cache/mu alone (mu4e's index) and never touches docker volumes.

PATH="$HOME/.bun/bin:$HOME/.cargo/bin:$PATH"
export DOCKER_HOST="${DOCKER_HOST:-unix://$XDG_RUNTIME_DIR/docker.sock}"
export FNM_DIR="${FNM_DIR:-$HOME/fnm}"

before=$(df --output=avail -B1 "$HOME" | tail -1)

command -v docker >/dev/null && {
	docker image prune -af --filter until=168h
	docker builder prune -af --filter until=168h
}
rm -rf "$HOME/.bun/install/cache"
command -v fnm >/dev/null && {
	# newest installed node; pnpm needs node:sqlite (node >= 22)
	node=$(fnm list | grep -o 'v[0-9.]*' | sort -V | tail -1)
	fnm exec --using="$node" npm cache clean --force
	fnm exec --using="$node" pnpm store prune
}
command -v go   >/dev/null && go clean -cache
rm -rf "$HOME/.cache/paru/clone"

after=$(df --output=avail -B1 "$HOME" | tail -1)
echo "freed $(numfmt --to=iec -- $((after - before)))"
