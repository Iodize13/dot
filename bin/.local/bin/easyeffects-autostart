#!/bin/sh
# EasyEffects 8.x does not persist the last-loaded preset across restarts,
# so start the service and load the preset explicitly once it is up.
PRESET="${1:-balanced-earbuds}"

easyeffects --service-mode --hide-window &

# Wait for the EE sink to appear (service connected to PipeWire), max ~15s.
i=0
while [ "$i" -lt 150 ]; do
    pactl list short sinks 2>/dev/null | grep -q easyeffects_sink && break
    sleep 0.1
    i=$((i + 1))
done

easyeffects -l "$PRESET"
