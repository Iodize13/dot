#!/bin/sh

# src: https://www.youtube.com/watch?v=SRqVuAUP2N0
wall=$(find ~/pix/wall/ -type f -name "*.jpg" -o -name "*.png" | shuf -n 1)

# generate color scheme (skip wal's wallpaper setter, xwallpaper handles it)
wal -c
wal -i $wall -n
xwallpaper --zoom $wall

# sync sxbar colours with the new pywal scheme and restart it
